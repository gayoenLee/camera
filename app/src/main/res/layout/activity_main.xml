<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:opencv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
 >

    <org.opencv.android.JavaCameraView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        opencv:camera_id="any"
        opencv:show_fps="true"
        android:visibility="gone"
        android:id="@+id/activity_surface_view"

        />

    <Button
        android:id="@+id/no_effect"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="no"
     android:layout_alignParentBottom="true"
        android:visibility="gone"/>
        <!--android:layout_toEndOf="@+id/magic_effect_btn"
        android:layout_above="@+id/magic_effect_btn"-->

    <Button
        android:id="@+id/gray_effect"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="gray"
        android:layout_toRightOf="@+id/no_effect"
        android:layout_alignBottom="@+id/no_effect"
        android:visibility="gone"/>
    <Button
        android:id="@+id/hsv_effect"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="hsv"
        android:layout_toRightOf="@+id/gray_effect"
        android:layout_alignBottom="@id/gray_effect"
        android:visibility="gone"/>
    <Button
        android:id="@+id/smoothing_effect"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="smoothing"
        android:layout_toRightOf="@id/hsv_effect"
        android:layout_alignBottom="@+id/hsv_effect"
        android:visibility="gone"
        />
    <Button
        android:id="@+id/roi_effect"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="roi"
        android:layout_toRightOf="@+id/smoothing_effect"
        android:layout_alignBottom="@+id/smoothing_effect"
        android:visibility="gone"/>


    <ImageButton
        android:id="@+id/change_direction_btn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_autorenew_black_24dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="20dp"
        />

 <ImageButton
     android:id="@+id/take_photo"
     android:layout_width="60dp"
     android:layout_height="60dp"
     android:layout_alignParentRight="true"
     android:layout_alignParentBottom="true"
     android:layout_marginRight="128dp"
     android:layout_marginBottom="-1dp"
     android:src="@android:drawable/ic_menu_camera" />

 <ImageButton
     android:id="@+id/overlay_image_btn"
     android:layout_width="60dp"
     android:layout_height="60dp"
     android:layout_alignLeft="@+id/take_photo"
     android:layout_alignParentLeft="true"
     android:layout_alignParentBottom="true"
     android:layout_marginLeft="141dp"
     android:layout_marginBottom="0dp"
     android:layout_toRightOf="@+id/magic_effect_btn"
     android:background="@null"
     android:src="@drawable/ic_video_call_black_24dp" />
    <Button
        android:id="@+id/glasses"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="안경"
        android:layout_alignParentBottom="true"
        android:layout_alignTop="@+id/overlay_image_btn"
        android:visibility="gone"/>
    <Button
        android:id="@+id/mustache"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="수염"
        android:layout_toRightOf="@+id/glasses"
        android:layout_alignBottom="@+id/glasses"
        android:visibility="gone"/>



 <ImageButton
     android:id="@+id/magic_effect_btn"
     android:layout_width="60dp"
     android:layout_height="60dp"
     android:layout_alignParentStart="true"
     android:layout_alignParentBottom="true"
     android:layout_marginStart="28dp"
     android:layout_marginLeft="20dp"
     android:layout_marginBottom="1dp"
     android:src="@drawable/ic_color_lens_black_24dp" />


</RelativeLayout>